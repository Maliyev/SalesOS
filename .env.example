# Copy to .env. Never commit .env or paste keys into chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional database override; Railway volume is automatically used by runner.
# SALESOS_DATABASE_PATH=data/salesos.db
# Optional WhatsApp: all four credential values are required to enable it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v25.0
# Optional provider used only if enabled in config.json.
OPENROUTER_API_KEY=
